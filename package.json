{
  "name": "xminal",
  "version": "0.11.0",
  "description": "XMINAL — Every coding agent. One terminal. Provider-agnostic fullscreen TUI (pure Node), agent runtime, 46 built-in providers, sessions, MCP, memory, worktrees, Ralph loops.",
  "license": "MIT",
  "author": "XMINAL contributors",
  "bin": {
    "xminal": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets",
    "docs",
    "scripts",
    "SECURITY.md",
    "AGENTS.md",
    "site",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.cjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "dev": "node dist/index.js",
    "verify": "npm run build && npm test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "xminal",
    "ai",
    "agentic-ai",
    "coding-agent",
    "terminal",
    "cli",
    "tui",
    "mcp",
    "acp",
    "orchestration",
    "openrouter",
    "ollama",
    "local-llm"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quitsaurabhverma2008-sketch/xminal.git"
  },
  "homepage": "https://github.com/quitsaurabhverma2008-sketch/xminal",
  "bugs": "https://github.com/quitsaurabhverma2008-sketch/xminal/issues"
}
